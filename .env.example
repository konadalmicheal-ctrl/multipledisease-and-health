# Copy to .env for local use. Never upload real secrets to GitHub.
SECRET_KEY=replace-with-a-long-random-secret
# Optional PostgreSQL connection string for hosting
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Optional admin account created if it does not already exist
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-strong-password-here
# Set COOKIE_SECURE=1 when HTTPS is enabled on your host
COOKIE_SECURE=0
